{
  "services": {
    "frontend": {
      "root": "frontend-angular/",
      "framework": "angular",
      "buildCommand": "npm run build",
      "devCommand": "npm start"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "api.index:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}